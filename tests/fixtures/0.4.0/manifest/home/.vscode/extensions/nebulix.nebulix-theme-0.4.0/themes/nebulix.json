    "editor.findMatchBackground": "#FF4FD855",
    "editor.wordHighlightBackground": "#A66BFF33",
    "editorBracketMatch.border": "#FF4FD8",
    "editorBracketMatch.background": "#261C42",
    "editorGroupHeader.tabsBackground": "#0B0812",
    "tab.activeBackground": "#0B0812",
