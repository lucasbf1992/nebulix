    "gitDecoration.untrackedResourceForeground": "#5CF2A0",
    "gitDecoration.deletedResourceForeground": "#FF5C8A",
    "editorError.foreground": "#FF5C8A",
    "editorWarning.foreground": "#F5D76E",
    "editorInfo.foreground": "#3BE8E8",
    "textLink.foreground": "#3BE8E8",
    "menu.background": "#1B1430",
    "menu.selectionBackground": "#261C42",
    "terminal.ansiBlack": "#1B1430",
    "terminal.ansiBrightBlack": "#3A2C63",
    "terminal.ansiRed": "#FF5C8A",
    "terminal.ansiBrightRed": "#FF85A8",
    "terminal.ansiGreen": "#5CF2A0",
    "terminal.ansiBrightGreen": "#8AF7BE",
    "terminal.ansiYellow": "#F5D76E",
    "terminal.ansiBrightYellow": "#FAE59B",
    "terminal.ansiBlue": "#7C8CFF",
