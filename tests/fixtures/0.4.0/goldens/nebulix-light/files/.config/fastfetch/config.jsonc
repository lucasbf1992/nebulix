  "display": { "color": { "keys": "38;2;107;61;217", "title": "38;2;194;30;155", "separator": "38;2;125;114;163" }, "separator": "  " },
  "modules": [
    "title", "separator",
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "de", "key": "DE" },
    { "type": "shell", "key": "Shell" },
    { "type": "theme", "key": "Theme" },
    { "type": "icons", "key": "Icons" },
    { "type": "terminalfont", "key": "Font" },
    "break", "colors"
  ]
}
