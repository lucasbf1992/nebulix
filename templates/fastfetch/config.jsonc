// SPDX-License-Identifier: GPL-3.0-or-later
// ${name} ${version} — fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "builtin", "source": "ubuntu_small", "color": { "1": "38;2;${purple|semi}", "2": "38;2;${magenta|semi}" }, "padding": { "right": 3 } },
  "display": { "color": { "keys": "38;2;${purple|semi}", "title": "38;2;${magenta|semi}", "separator": "38;2;${fg-2|semi}" }, "separator": "  " },
  "modules": [
    "title", "separator",
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "de", "key": "DE" },
    { "type": "shell", "key": "Shell" },
    { "type": "theme", "key": "Theme" },
    { "type": "icons", "key": "Icons" },
    { "type": "terminalfont", "key": "Font" },
    "break", "colors"
  ]
}
