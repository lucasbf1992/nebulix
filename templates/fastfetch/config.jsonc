// ${name} ${version} — fastfetch
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "builtin", "source": "ubuntu_small", "color": { "1": "38;2;166;107;255", "2": "38;2;255;79;216" }, "padding": { "right": 3 } },
  "display": { "color": { "keys": "38;2;166;107;255", "title": "38;2;255;79;216", "separator": "38;2;111;100;150" }, "separator": "  " },
  "modules": [
    "title", "separator",
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "de", "key": "DE" },
    { "type": "shell", "key": "Shell" },
    { "type": "theme", "key": "Theme" },
    { "type": "icons", "key": "Icons" },
    { "type": "terminalfont", "key": "Font" },
    "break", "colors"
  ]
}
